# Copy to .env (repo root) and fill in
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pillguard
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:5173
# Missed-dose grace period in minutes
MISSED_GRACE_MIN=30
# Optional AI features (pill ID, blister verification, interaction explanation)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
